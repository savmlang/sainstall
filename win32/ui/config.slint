import {
    Palette,
    Button,
    HorizontalBox,
    TextEdit,
    ScrollView,
    ListView,
    VerticalBox,
    GridBox,
    ProgressIndicator,
    TabWidget,
    CheckBox,
} from "std-widgets.slint";
import { SaText, AnimatedPage, ReuseBottom, SaStyledText } from "reuse.slint";
import { HelperTxts } from "gplv3summary.slint";
import { Section, BoxItem } from "section.slint";

import { Configuration, ConfigDefaults } from "structs.slint";

export component Configure inherits AnimatedPage {
    callback next();

    in property <bool> repair;
    in-out property <Configuration> configs;

    VerticalLayout {
        Rectangle {

            HorizontalBox {
                alignment: center;
                padding-left: 0.5rem;
                padding-top: 2rem;

                Image {
                    source: @image-url("../assets/salang.png");
                    height: 2.5rem;
                    width: 2.5rem;
                }

                SaText {
                    text: "Customize";
                    font-size: 2rem;
                }
            }
        }

        HorizontalBox {
            padding-top: 2rem;
            padding-bottom: 2rem;
            alignment: LayoutAlignment.center;
            padding-left: 6rem;
            padding-right: 6rem;

            SaStyledText {
                default-font-size: 1.4rem;
                text: @markdown("Let us **\{!repair ? "customize" : "repair"}** your ***`SaVM`*** installation");
            }
        }

        HorizontalBox {
            padding: 6rem;
            padding-top: 1rem;
            padding-bottom: 2rem;

            Rectangle {
                background: Palette.alternate-background.transparentize(50%);
                border-radius: 0.5rem;

                ScrollView {
                    VerticalLayout {
                        padding: 2rem;
                        spacing: 1.5rem;

                        CheckBox {
                            checked: true;
                            enabled: false;
                            text: "SaVM Core";
                        }

                        Section {
                            title: "SaVM SDK";
                            enabled: configs.sdkConfig != ConfigDefaults.sdkNone;
                            items: [
                                {
                                    label: "Include static libraries (.lib files)",
                                    default: configs.sdkConfig.keepStaticArchives,
                                    id: 0
                                },
                                {
                                    label: "Include Link stubs (.dll.lib files)",
                                    default: configs.sdkConfig.keepLibraryStubs,
                                    id: 1
                                },
                                { label: "Include C Headers", default: configs.sdkConfig.keepCHeaders, id: 2 }
                            ];

                            toggle(a, value) => {
                                if a == -1 {
                                    configs.sdkConfig = ConfigDefaults.sdkNone;
                                } else if a == -2 {
                                    configs.sdkConfig = ConfigDefaults.sdkDefault;
                                } else if a == 0 {
                                    configs.sdkConfig.keepStaticArchives = value;
                                } else if a == 1 {
                                    configs.sdkConfig.keepLibraryStubs = value;
                                } else if a == 2 {
                                    configs.sdkConfig.keepCHeaders = value;
                                }
                            }
                        }

                        Section {
                            title: "SaVM Extended";
                            enabled: configs.toolConfig != ConfigDefaults.toolNone;
                            items: [
                                {
                                    label: "SaVM Testing & Benchmarking Tool (satest)",
                                    default: configs.toolConfig.saTestBinary,
                                    id: 0
                                },
                                {
                                    label: "SaVM Desktop Application Runtime (savmrt, savmrtcache)",
                                    default: configs.toolConfig.saAppRuntime,
                                    id: 1
                                },
                            ];

                            toggle(a, value) => {
                                if a == -1 {
                                    configs.toolConfig = ConfigDefaults.toolNone;
                                }
                                else if a == -2 {
                                    configs.toolConfig = ConfigDefaults.toolDefault;
                                } else if a == 0 {
                                    configs.toolConfig.saTestBinary = value;
                                } else if a == 1 {
                                    configs.toolConfig.saAppRuntime = value;
                                }
                            }
                        }

                        CheckBox {
                            checked: configs.windowsConfig.addToPath;
                            text: "Add SaVM to PATH";

                            toggled => {
                                configs.windowsConfig.addToPath = self.checked;
                            }
                        }

                        CheckBox {
                            checked: configs.windowsConfig.startMenuEntries;
                            text: "Add Start Menu Entries";

                            toggled => {
                                configs.windowsConfig.startMenuEntries = self.checked;
                            }
                        }

                        CheckBox {
                            checked: true;
                            enabled: false;
                            text: "SaVM Uninstall & Repair Tool";
                        }
                    }
                }
            }
        }

        ReuseBottom {
            icon: @image-url("../assets/checkbox.svg");
            contdbtn: repair ? "Repair" : "Install";
            prog: 2 / 3;
            next => {
                next();
            }
        }
    }
}
