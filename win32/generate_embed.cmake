# Read binary as raw hex
set(LICENSE "${CMAKE_CURRENT_SOURCE_DIR}/../../LICENSE")
set(BUILD "${CMAKE_CURRENT_SOURCE_DIR}/../../build.zip")

file(READ "${LICENSE}" HEX_DATA_LICENSE HEX)
file(READ "${BUILD}" HEX_DATA_ZIP HEX)

# Convert raw hex string to: 0xXX, 0xYY, ...
string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1, " BYTE_ARRAY_LICENSE "${HEX_DATA_LICENSE}")
string(REGEX REPLACE "([0-9a-fA-F][0-9a-fA-F])" "0x\\1, " BYTE_ARRAY_ZIP "${HEX_DATA_ZIP}")

# Output constexpr header
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/generated/embedded_payload.h"
"// Auto-generated by CMake build step
#pragma once
#include <cstdint>
#include <cstddef>
inline constexpr uint8_t LicenseText[] = {
  ${BYTE_ARRAY_LICENSE}
};
inline constexpr size_t LicenseText_SIZE = sizeof(LicenseText);
inline constexpr uint8_t ZipFile[] = {
  ${BYTE_ARRAY_ZIP}
};
inline constexpr size_t ZipFile_SIZE = sizeof(ZipFile);
")